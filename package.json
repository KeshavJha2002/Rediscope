{
  "name": "rediscope",
  "version": "1.0.1",
  "description": "Interactive byte-level Redis RDB binary decompiler and visual state inspector",
  "bin": {
    "rediscope": "bin/rediscope.js"
  },
  "scripts": {
    "build": "go build -buildvcs=false -o dist/rediscope ./cmd/rediscope",
    "test": "go test ./...",
    "prepack": "cp README.npm.md README.md && npm run build",
    "postpack": "cp README.github.md README.md",
    "pack:local": "npm pack"
  },
  "files": [
    "bin/",
    "dist/",
    "prebuilds/",
    "README.md",
    "!README.npm.md",
    "!README.github.md",
    "LICENSE"
  ],
  "keywords": [
    "redis",
    "rdb",
    "decompiler",
    "debugging",
    "persistence",
    "byte-viewer",
    "state-inspector"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
